{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "left": 2,
      "top": 3,
      "right": 5
    },
    "color": {
    "1": "white",
    "2": "black"
    }
  },

  "display": {
    "separator": "",
    "constants": [
      "\u001b[48;2;43;43;69m",
      "\u001b[48;2;56;59;78m",
      "\u001b[90m│                                                            │\u001b[60D\u001b[39m"
    ]
  },

  "modules": [
    { "type": "custom", "key": " ", "format": "" },
    { "type": "custom", "key": " ", "format": "" },

    {
      "type": "custom",
      "key": "{$1}╭─────────────╮",
      "format": "{#90}{$2}╭────────────────────────────────────────────────────────────╮"
    },

    // === USER / TIME ===
    {
      "type": "title",
      "key": "{$1}│ User        │",
      "format": "{$2}{$3}{user-name}  {#2}[{home-dir}]"
    },
    {
      "type": "datetime",
      "key": "{$1}│ Datetime    │",
      "format": "{$2}{$3}{year}-{month-pretty}-{day-in-month} {hour-pretty}:{minute-pretty}:{second-pretty}"
    },

    // === SYSTEM IDENTITY ===
    {
      "type": "title",
      "key": "{$1}│ Host        │",
      "format": "{$2}{$3}{host-name}"
    },
    {
      "type": "host",
      "key": "{$1}│ Machine     │",
      "format": "{$2}{$3}{name} {#2}{version}"
    },
    {
      "type": "os",
      "key": "{$1}│ OS          │",
      "format": "{$2}{$3}{pretty-name} {#2}[{arch}]"
    },
    {
      "type": "kernel",
      "key": "{$1}│ Kernel      │",
      "format": "{$2}{$3}{sysname} {#2}[{release}]"
    },
    {
      "type": "uptime",
      "key": "{$1}│ Uptime      │",
      "format": "{$2}{$3}{hours}:{minutes}:{seconds}"
    },

    // === HARDWARE ===
    {
      "type": "cpu",
      "key": "{$1}│ CPU         │",
      "temp": true,
      "format": "{$2}{$3}{name} {#2}[{freq-max}]"
    },
    {
      "type": "gpu",
      "key": "{$1}│ GPU         │",
      "format": "{$2}{$3}{name}"
    },
    { 
      "type": "memory",
      "key": "{$1}│ Memory      │",
      "format": "{$2}{$3}{used} / {total} ({percentage}{$2})"
    },
    {
      "type": "disk",
      "key": "{$1}│ Disk        │",
      "format": "{$2}{$3}{size-used} / {size-total} ({size-percentage}{$2}) - {filesystem}"
    },
    {
      "type": "battery",
      "key": "{$1}│ Battery     │",
      "format": "{$2}{$3}{capacity}{$2} {status}"
    },

    // === SOFTWARE / ENVIRONMENT ===
    {
      "type": "packages",
      "key": "{$1}│ Packages    │",
      "format": "{$2}{$3}{pacman} (pacman)"
    },
    {
      "type": "de",
      "key": "{$1}│ Desktop     │",
      "format": "{$2}{$3}{pretty-name} {version}"
    },
    {
      "type": "wm",
      "key": "{$1}│ WM          │",
      "format": "{$2}{$3}{pretty-name} {protocol-name} {version}"
    },

    // === TERMINAL / APPEARANCE ===
    {
      "type": "terminal",
      "key": "{$1}│ Terminal    │",
      "format": "{$2}{$3}{pretty-name} {version}"
    },
    {
      "type": "shell",
      "key": "{$1}│ Shell       │",
      "format": "{$2}{$3}{pretty-name} {version}"
    },

    // === FOOTER ===
    {
      "type": "custom",
      "key": "{$1}╰─────────────╯",
      "format": "{#90}{$2}╰────────────────────────────────────────────────────────────╯"
    },
    { "type": "custom", "key": " ", "format": "" },
    { "type": "custom", "key": " ", "format": "" }
  ]
}
